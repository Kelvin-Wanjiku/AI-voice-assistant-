# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by git so your secrets stay private.

# Where the frontend runs (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Postgres connection string (Project Settings > Database).
# Leave empty for now and Milo will still start; the database check will say "not set up yet".
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres
DATABASE_URL=
