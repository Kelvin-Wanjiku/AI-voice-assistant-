# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by git so your secrets stay private.

# Where the frontend runs (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ---- Milo's brain ----
# Which AI provider to use: groq, gemini, mistral or openrouter
LLM_PROVIDER=groq
# Your API key from that provider:
#   groq:       https://console.groq.com/keys
#   gemini:     https://aistudio.google.com/apikey
#   mistral:    https://console.mistral.ai/api-keys
#   openrouter: https://openrouter.ai/keys
LLM_API_KEY=
# Optional. Leave empty to use the provider's default model
# (groq: openai/gpt-oss-120b, gemini: gemini-3.5-flash-lite, mistral: mistral-small-latest).
# OpenRouter has no default: pick a free model on openrouter.ai and put its name here.
LLM_MODEL=
# Optional. For "thinking" models: low, medium or high. Leave empty for the provider's default.
LLM_REASONING_EFFORT=

# ---- Waiting ----
# When Milo needs to look something up and it takes longer than this many seconds,
# it says something like "Let me just check the weather for you", then answers by itself.
HOLDING_AFTER_SECONDS=3

# ---- Web search (optional) ----
# A free key from https://app.tavily.com lets Milo search the web. Leave empty to switch it off.
TAVILY_API_KEY=

# ---- Milo's memory ----
# Leave empty to keep memories in a file on this computer (backend/milo.db). Nothing to set up.
# To use Supabase instead, paste its "Session pooler" connection string here, changing the start
# from postgresql:// to postgresql+psycopg://
DATABASE_URL=
